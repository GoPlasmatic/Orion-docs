# Everything this repository generates or fetches.

# Python bytecode and virtual environments.
__pycache__/
*.py[cod]
*$py.class
.mypy_cache/
.ruff_cache/
.pytest_cache/
.venv/
venv/

# mdBook rendered output (build.sh).
book/

# Pinned mdBook binary fetched by build.sh when mdbook is not on PATH.
.bin/

# Wrangler local dev state (`npx wrangler dev`).
.wrangler/

# Node dependencies.
node_modules/

# Vale third-party style packages fetched by `vale sync`.
styles/Google/

# Cargo build output for the drift guards.
target/
drift/target/

# Local-only [patch] onto an Orion working tree (CONTRIBUTING-DOCS.md).
.cargo/config.toml
